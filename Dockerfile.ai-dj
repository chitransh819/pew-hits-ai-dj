# Dockerfile.ai-dj
# AI DJ Service for Pew Hits Radio
FROM python:3.11-slim-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    libmagic1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for caching
COPY requirements.txt .

# Install Python dependencies (PyTorch from PyPI for ARM64)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . /app/

# Create directories
RUN mkdir -p /data /models /config /cache/english /cache/desi

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV LOG_LEVEL=INFO
ENV AI_DJ_HOST=0.0.0.0
ENV AI_DJ_PORT=8000
ENV CACHE_DIR_ENGLISH=/cache/english
ENV CACHE_DIR_DESI=/cache/desi
ENV DB_PATH=/data/ai_dj.db
ENV MODELS_DIR=/models

# Expose port
EXPOSE 8000

# Entry point
CMD ["python", "-m", "ai_dj.main"]
